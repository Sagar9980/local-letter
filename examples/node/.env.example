# Your local-letter API. No trailing slash.
LOCAL_LETTER_BASE_URL=http://localhost:4000

# Project API key: dashboard -> API Keys -> create. Shown once, at creation.
LOCAL_LETTER_API_KEY=

# Sent directly to Resend by the SDK. local-letter never receives it.
RESEND_API_KEY=

# Resend's shared sender works with no domain setup, but only delivers to the
# email on your own Resend account. Verify a domain to mail anyone else.
MAIL_FROM=onboarding@resend.dev

# Template key to render, and who to send to.
TEMPLATE_KEY=welcome-email
TEST_TO=

# Port for server.js
PORT=3000
