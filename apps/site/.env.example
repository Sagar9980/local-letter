# Public origin this site is served from. Canonical links and og:url are built
# against it, so set it to the real origin in production or they will point at
# the default below.
NEXT_PUBLIC_SITE_URL="https://local-letter.sagardhami.com"

NEXT_PUBLIC_CONTACT_EMAIL=""

GA_ID=""

# Required for the contact form's /api/contact route to send mail via Resend.
RESEND_API_KEY=""
# Optional. "from" address used for contact form emails. Must be on a domain
# verified with Resend, or the shared onboarding@resend.dev test sender.
CONTACT_FROM_EMAIL=""


